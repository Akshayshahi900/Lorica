    "test:unit": "tsx --test ../../apps/api/src/controllers/github.controller.test.ts ../../packages/context/src/reviewContext.test.ts ../../packages/context/src/reviewPlan.test.ts ../../packages/context/src/reviewSettings.test.ts ../../packages/types/src/reviewSettings.test.ts ../../packages/llm/src/prompt.test.ts ../../packages/llm/src/client.test.ts ../../packages/llm/src/providers.test.ts ../../packages/vcs/src/github/commentBuilder.test.ts ../../packages/vcs/src/github/postComment.test.ts src/indexer/indexRepository.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 src/reviewProcessor.integration.test.ts ../../apps/api/src/webhookIntake.integration.test.ts",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@lorica/context": "workspace:*",
    "@lorica/db": "workspace:*",
    "@lorica/llm": "workspace:*",
    "@lorica/queue": "workspace:*",
    "@lorica/types": "workspace:*",
    "@lorica/vcs": "workspace:*",
    "@types/express": "^5.0.6",
    "bullmq": "^6.0.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "neo4j-driver": "^6.2.0",
    "tree-sitter": "^0.25.1",
    "tree-sitter-typescript": "^0.23.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  }
}

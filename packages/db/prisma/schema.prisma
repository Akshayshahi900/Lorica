  // This is your Prisma schema file,
  // learn more about it in the docs: https://pris.ly/d/prisma-schema

  // Get a free hosted Postgres database in seconds: `npx create-db`

  generator client {
    provider = "prisma-client-js"
  }

  datasource db {
    provider = "postgresql"
  }

  enum PullRequestStatus {
    pending
    processing
    completed
    failed
  }

  enum ReviewJobStatus {
    queued
    running
    completed
    failed
    superseded // a newer commit was pushed before this review ran
  }

  model Repository {
    id          Int           @id @default(autoincrement())
    githubId    BigInt        @unique
    name        String
    fullName    String        @unique
    owner       String

    pullRequests PullRequest[]
  }

  model PullRequest {
    id            Int                @id @default(autoincrement())
    githubPrId    BigInt             @unique
    prNumber        Int       // pr number
    repoName         String    // reponame
    title            String?
    author           String?
    headSha       String
    // GitHub's pull_request.updated_at for the event that set headSha. Events
    // can arrive out of order; an older one must not move the head back.
    headUpdatedAt DateTime?
    status        PullRequestStatus
    action        String


    installationId   Int             // installation.id
    repoOwner        String              // repo.owner.login
    repositoryId  Int                 
    repository    Repository         @relation(fields: [repositoryId], references: [id])

    reviewJobs    ReviewJob[]

    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt
  }

  model ReviewJob {
    id             Int               @id @default(autoincrement())

    pullRequestId  Int
    pullRequest    PullRequest       @relation(fields: [pullRequestId], references: [id])

    // One review per pushed commit: redelivered webhooks resolve to the same row.
    headSha        String

    status         ReviewJobStatus
    commentsCount  Int               @default(0)

    // The database, not Redis, decides when a review runs. A dispatcher hands
    // due jobs to the worker, and a job whose lease lapses (worker crashed or
    // slept mid-review) becomes due again.
    attempts       Int               @default(0)
    nextRunAt      DateTime          @default(now())
    leaseUntil     DateTime?
    // Identifies the attempt holding the lease. Results are written, and the
    // review published, only while this attempt still holds it.
    leaseToken     String?
    lastError      String?

    createdAt      DateTime @default(now())
    updatedAt      DateTime @default(now()) @updatedAt
    completedAt    DateTime?

    @@unique([pullRequestId, headSha])
    @@index([status, nextRunAt])
  }

  // One row per GitHub delivery (X-GitHub-Delivery). Written in the same
  // transaction as the job it produced, so a delivery is recorded exactly when
  // its effects are durable and a redelivery is recognised and skipped.
  model WebhookDelivery {
    id          String   @id // X-GitHub-Delivery GUID
    event       String
    action      String?
    reviewJobId Int?
    receivedAt  DateTime @default(now())
  }

  // A user's own review model. No row means the deployment's default model
  // (OPENROUTER_API_KEY + LLM_MODEL) reviews their pull requests.
  model ModelSettings {
    id               Int      @id @default(autoincrement())
    // GitHub login, lowercased; matched against PullRequest.repoOwner.
    owner            String   @unique
    provider         String   // see LLM_PROVIDERS in @lorica/llm
    model            String
    baseUrl          String?
    // AES-256-GCM, keyed by LLM_SETTINGS_ENCRYPTION_KEY. Never returned by the API.
    apiKeyCiphertext String?
    // Effective context window found by the capability check (or entered).
    contextWindow    Int?
    verifiedAt       DateTime?

    createdAt        DateTime @default(now())
    updatedAt        DateTime @default(now()) @updatedAt
  }

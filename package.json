{
  "name": "Lorica",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "LORICA_ROOT=\"$PWD\" node --env-file=.env ./node_modules/turbo/bin/turbo run dev dev:worker --parallel",
    "test:index": "LORICA_ROOT=\"$PWD\" node --env-file=.env ./node_modules/turbo/bin/turbo run test:index --filter=@lorica/worker",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:generate": "pnpm --filter @lorica/db exec prisma generate",
    "db:migrate": "pnpm --filter @lorica/db exec prisma migrate deploy",
    "db:migrate:dev": "pnpm --filter @lorica/db exec prisma migrate dev",
    "db:studio": "pnpm --filter @lorica/db exec prisma studio"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.5",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  }
}
